# Required for movies and TV metadata. Create a v3 API key at themoviedb.org.
TMDB_KEY=replace_with_your_tmdb_v3_api_key

# Optional
PORT=3000
WATCH_REGION=IN
ADMIN_CACHE_TOKEN=replace_with_a_long_random_secret
CACHE_MAX_ITEMS=900
# Extra comma-separated Live TV hosts, only if you add your own trusted channels.
HLS_ALLOWED_HOSTS=
