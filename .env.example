# StreamVerse environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---- Required ----
# TMDB v3 API key: https://www.themoviedb.org/settings/api
# Without this, movie/TV rows stay empty. Anime still works (Jikan/AniList need no key).
TMDB_KEY=

# ---- Optional ----
# Port the server listens on. Render injects this automatically.
PORT=3000

# Watch-provider region used for availability lookups (ISO 3166-1 alpha-2).
WATCH_REGION=IN

# Max entries held in the in-memory LRU cache.
CACHE_MAX_ITEMS=900

# Bearer token required by POST /api/admin/cache/clear.
# Leave blank to disable the endpoint. Render generates one via render.yaml.
ADMIN_CACHE_TOKEN=

# Extra hostnames allowed through the /api/hls proxy, comma-separated.
# HLS_ALLOWED_HOSTS=example.com,cdn.example.net
